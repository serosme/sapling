{
  "name": "sapling",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --no-tui",
    "preview": "nuxt preview",
    "build": "nuxt build",
    "deploy": "pnpm run build && pnpm run db:migrate && wrangler deploy --keep-vars",
    "db:backup": "wrangler d1 export DB --remote --output ./db.sql",
    "db:generate": "nuxt db generate",
    "db:migrate": "wrangler --config .output/server/wrangler.json d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.79",
    "@nuxthub/core": "0.10.11",
    "ai": "7.0.154",
    "drizzle-orm": "0.45.4",
    "nuxt": "4.6.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@libsql/client": "0.18.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "vue-tsc": "3.3.13",
    "wrangler": "4.153.0"
  }
}
